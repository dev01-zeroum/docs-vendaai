{
  "name": "vendaai-docs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "docusaurus start",
    "build": "docusaurus build",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "preview": "docusaurus build && docusaurus serve",
    "swizzle": "docusaurus swizzle",
    "upgrade": "npm install @docusaurus/core@latest @docusaurus/preset-classic@latest",
    "lint": "npm run lint:format && npm run lint:md",
    "lint:format": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "fix": "prettier --write . && markdownlint-cli2 --fix"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.2",
    "@mdx-js/react": "^3.0.0",
    "medium-zoom": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=18.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.9.6"
  }
}
